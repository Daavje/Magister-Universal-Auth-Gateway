# For local development; public deployments REQUIRE https://
PUBLIC_BASE_URL=http://127.0.0.1:8000
DATABASE_PATH=./data/gateway.sqlite3
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
TOKEN_ENCRYPTION_KEY=

# Only fill when an authorized Magister OAuth client and documented endpoints
# have been provided by the operator/school/vendor.
MAGISTER_CLIENT_ID=
MAGISTER_CLIENT_SECRET=
MAGISTER_AUTHORIZE_URL=
MAGISTER_TOKEN_URL=
MAGISTER_CALENDAR_URL=
MAGISTER_SCOPES=offline_access
MAGISTER_FROM_PARAM=from
MAGISTER_TO_PARAM=to
